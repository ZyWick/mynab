# Postgres
DATABASE_URL=postgresql+asyncpg://ynab:ynab@localhost:5432/ynab

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Plaid (sandbox)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# Encryption key for Plaid access tokens at rest (Fernet, 32 url-safe base64 bytes)
TOKEN_ENCRYPTION_KEY=
